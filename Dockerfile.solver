# Dockerfile.solver
FROM ubuntu:22.04

# Установка компилятора и зависимостей
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopenblas-dev \
    libopenmpi-dev \
    libgomp1 \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Копирование кода
COPY cpp_solver/ /app/cpp_solver/
COPY remote_solver.py /app/
COPY requirements.txt /app/
COPY cpp_bridge.py /app/

# Компиляция C++ кода
WORKDIR /app/cpp_solver
RUN g++ -shared -fopenmp -O3 -std=c++11 -fPIC cg_solver.cpp -o libcg_solver.so

# Установка Python зависимостей
WORKDIR /app
RUN pip3 install --no-cache-dir -r requirements.txt

# Создание симлинка для библиотеки
RUN ln -s /app/cpp_solver/libcg_solver.so /usr/lib/libcg_solver.so

# Установка переменных окружения
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
ENV PYTHONUNBUFFERED=1

# Открываем порт
EXPOSE 5000

# Запуск
CMD ["python3", "remote_solver.py"]